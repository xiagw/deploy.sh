#!/usr/bin/env bash
# -*- coding: utf-8 -*-

# 设置基础路径
CLOUD_CLI_HOME=$(dirname "$(dirname "$(readlink -f "$0")")")
export CLOUD_CLI_HOME

show_help() {
    echo "Usage: cloud [--provider <provider>] <command> [options]"
    echo
    echo "Supported providers:"
    echo "  aliyun   - Alibaba Cloud"
    echo "  huawei   - Huawei Cloud"
    echo "  tencent  - Tencent Cloud"
    echo "  aws      - Amazon Web Services"
    echo
    echo "Examples:"
    echo "  cloud --provider aliyun ecs list"
    echo "  cloud --provider aws ec2 list"
    echo "  cloud --provider huawei ecs list"
    echo "  cloud --provider tencent cvm list"
}

main() {
    local provider="aliyun"  # 默认使用阿里云
    local args=()

    # 解析参数
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --provider)
                if [[ -z "$2" || "$2" == -* ]]; then
                    echo "错误：--provider 选项需要指定一个云服务提供商" >&2
                    show_help
                    exit 1
                fi
                provider="$2"
                shift 2
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done

    # 验证提供商
    case "$provider" in
        aliyun|huawei|tencent|aws)
            # 直接执行对应提供商的 main.sh
            local provider_script="${CLOUD_CLI_HOME}/cloud/${provider}/main.sh"
            if [[ ! -f "$provider_script" ]]; then
                echo "错误：未找到云服务提供商脚本：$provider_script" >&2
                exit 1
            fi
            exec "$provider_script" "${args[@]}"
            ;;
        *)
            echo "错误：不支持的云服务提供商：$provider" >&2
            show_help
            exit 1
            ;;
    esac
}

main "$@"
