# =============================================================================
# 静态前端多阶段模板（vue-cli/vite/react-scripts/umi）
# builder: node 环境跑 build.sh web <script>（install + 框架构建），
#          产物输出到 /build_output/usr/share/nginx/html
# final:   官方 nginx:alpine，继承其 ENTRYPOINT/CMD（/docker-entrypoint.sh 前台启动），
#          SPA 路由 fallback 见 nginx-spa.conf
# 由 repo_inject_file 在 detect_node_framework 命中静态框架时注入为 Dockerfile
# =============================================================================
ARG MIRROR=
ARG BUILD_IMAGE=node
ARG BUILD_TAG=22-slim
ARG IS_CHINA=false
ARG BUILD_URL=https://gitee.com/xiagw/deploy.sh/raw/main/conf/root/opt/build.sh
ARG WEB_BUILD_SCRIPT=build

################################################################################
#### 阶段 1：Node 构建 ####
FROM ${MIRROR}${BUILD_IMAGE}:${BUILD_TAG} AS builder
## FROM之前的全局变量必须重新定义
ARG IS_CHINA
ARG BUILD_URL
ARG WEB_BUILD_SCRIPT
WORKDIR /src
# 依赖缓存（npm），源码由构建时 bind mount 到 /src
RUN --mount=type=cache,target=/root/.npm,id=npm_cache,sharing=shared \
    --mount=type=bind,target=/src,rw \
    set -xe; \
    BUILD_SH=/src/root/opt/build.sh; \
    [ -f $BUILD_SH ] || BUILD_SH=build.sh; \
    [ -f $BUILD_SH ] || curl -fLo $BUILD_SH $BUILD_URL; \
    if command -v bash >/dev/null 2>&1; then bash $BUILD_SH web ${WEB_BUILD_SCRIPT}; else sh $BUILD_SH web ${WEB_BUILD_SCRIPT}; fi
    ## 假如此处中断，表明构建失败，请检查代码

################################################################################
#### 阶段 2：Nginx 静态服务 ####
FROM ${MIRROR}nginx:alpine AS final
# builder 产物按根文件系统布局放入 /（→ /usr/share/nginx/html）
COPY --from=builder /build_output/ /
# SPA 路由 fallback，覆盖镜像自带 default.conf
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
