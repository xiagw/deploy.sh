{
    "version": "1.0",
    "project": "root/example",
    "description": "示例项目配置",
    "documentation": {
        "description": "此文件用于单个项目的部署配置，放在 data/conf/namespace/project-name.json",
        "advantages": [
            "避免全局配置文件过大",
            "减少版本冲突",
            "更好的权限控制",
            "提高解析性能"
        ],
        "note": "此配置文件是必需的，如果不存在会自动从模板创建，但必须修改后才能继续部署"
    },
    "build": {
        "method": "auto",
        "prefer_docker": true,
        "description": "构建方式配置: auto=自动检测, docker=强制Docker, system=强制系统命令; prefer_docker: 自动模式下是否优先 Docker 构建"
    },
    "deploy": {
        "method": "auto",
        "prefer_k8s": true,
        "description": "部署方式配置: auto=自动检测, k8s=强制k8s, docker=强制docker-compose, rsync=强制rsync+ssh, fc=强制阿里云函数计算, ftp=强制FTP, sftp=强制SFTP, oss=强制阿里云OSS; prefer_k8s: 自动模式下是否优先 k8s 部署"
    },
    "branches": [
        {
            "branch": "develop",
            "description": "开发环境配置",
            "hosts": [
                {
                    "user": "dev",
                    "host": "192.0.2.2",
                    "port": "22",
                    "rsync_src": "dist",
                    "rsync_dest": "/www/develop/example",
                    "db_host": "m01.example.com",
                    "db_user": "dev",
                    "db_name": "example_dev",
                    "helm_dir": "/runner/data/helm/root/example"
                }
            ]
        },
        {
            "branch": "main",
            "description": "生产环境配置",
            "hosts": [
                {
                    "user": "prod",
                    "host": "192.0.2.3",
                    "port": "2222",
                    "rsync_src": "dist",
                    "rsync_dest": "/www/main/example",
                    "db_host": "mm01.example.com",
                    "db_user": "prod",
                    "db_name": "example_prod",
                    "helm_dir": "/runner/data/helm/root/example"
                }
            ]
        }
    ]
}
