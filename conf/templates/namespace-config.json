{
    "version": "1.0",
    "description": "命名空间级部署配置文件",
    "documentation": {
        "description": "此文件用于整个命名空间下所有项目的共享配置，放在 data/projects/namespace.json",
        "use_case": "适用于同一命名空间下多个项目使用相同部署配置的场景",
        "fallback": "如果项目专用配置不存在，会使用此文件；如果此文件也不存在，会使用全局 deploy.json"
    },
    "projects": [
        {
