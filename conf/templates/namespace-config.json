                        {
                            "ssh_host": "dev@192.168.100.102",
                            "ssh_port": "22",
                            "rsync_src": "dist",
                            "rsync_dest": "/www/develop/project1"
                        }
                    ]
                }
            ]
        },
        {
            "project": "root/project2",
            "description": "项目2配置",
