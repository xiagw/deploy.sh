# Redis 基础镜像，可通过 REDIS_PASSWORD 配置密码。
# 示例：docker build -f conf/dockerfile/Dockerfile.base.redis -t redis:base . && docker run -e REDIS_PASSWORD=xxx redis:base

ARG MIRROR=
ARG BUILD_IMAGE=redis
ARG BUILD_TAG=latest
ARG RUN_IMAGE=redis
ARG RUN_TAG=latest

ARG IN_CHINA=false
ARG INSTALL_NGINX=true
ARG BUILD_URL=https://gitee.com/xiagw/deploy.sh/raw/main/conf/dockerfile/root/opt/build.sh

# FROM ${MIRROR}${BUILD_IMAGE}:${BUILD_TAG} AS builder
# ARG IN_CHINA
# ARG INSTALL_NGINX
# ARG BUILD_URL

FROM ${MIRROR}${RUN_IMAGE}:${RUN_TAG} AS final
ARG IN_CHINA
ARG INSTALL_NGINX
ARG BUILD_URL

LABEL MAINTAINER="xiagw <fxiaxiaoyu@gmail.com>"

ARG TZ=UTC

ENV TZ=${TZ}

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

VOLUME /data

EXPOSE 6379

# COPY ./root/ /
# CMD ["redis-server", "/usr/local/etc/redis/redis.conf"]
# CMD ["redis-server"]
